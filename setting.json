                        "color": "#B22222",
                        "strikethrough": false,
                        "underline": false,
                        "backgroundColor": "transparent",
                        "bold": false,
                        "italic": false,
                },
                {
                        "tag": "@todo",
                        "color": "#B22222",
                        "strikethrough": false,
                        "underline": false,
                        "backgroundColor": "transparent",
                        "bold": false,
                        "italic": false,
                },
                {
                        "tag": "?",
                        "color": "#CD853F", // in light theme
                        "strikethrough": false,
                        "underline": false,
                        "backgroundColor": "transparent",
                        "bold": false,
                        "italic": false,
                },
                {
                        "tag": ".",
                        "color": "#CD853F", // in light theme
                        "strikethrough": false,
                        "underline": false,
                        "backgroundColor": "transparent",
                        "bold": false,
                        "italic": false,
                },
                {
                        "tag": "@learn",
                        "color": "#fff0f5", // in dark theme
                        // "color": "#2F4F4F", // in light theme
                        "strikethrough": false,
                        "underline": false,
                        "backgroundColor": "transparent",
                        "bold": false,
                        "italic": false,
                },
                {
                        "tag": "@note",
                        // "color": "#fff0f5", //in dark theme
                        "color": "#4B0082", // in light theme
                        "strikethrough": false,
                        "underline": false,
                        "backgroundColor": "transparent",
                        "bold": false,
