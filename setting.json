                },
                {
                        "tag": "@audit",
                        "color": "#A52A2A",
                        "strikethrough": false,
                        "underline": false,
                        "backgroundColor": "transparent",
                        "bold": false,
                        "italic": false,
                },
                {
                        "tag": "@follow",
                        "color": "#FF8C00",
                        "strikethrough": false,
                        "underline": false,
                        "backgroundColor": "transparent",
                        "bold": false,
                        "italic": false,
                },
                {
                        "tag": "@report",
                        "color": "#FF8C00",
                        "strikethrough": false,
                        "underline": false,
                        "backgroundColor": "transparent",
                        "bold": false,
                        "italic": false,
                },
        ],
        "eyecons.folderColor": "purple",
        "editor.stickyScroll.enabled": false,
        "[solidity]": {
                "editor.defaultFormatter": "NomicFoundation.hardhat-solidity",
        },
        "editor.unicodeHighlight.ambiguousCharacters": false,
        "workbench.editor.showTabs": "single",
        "workbench.activityBar.location": "hidden",
        "editor.cursorSmoothCaretAnimation": "on",

        //@note css and js load
        "vscode_custom_css.imports": [
                "file:///Users/max/custom_vscode/custom_vscode.css",
                "file:///Users/max/custom_vscode/custom_vscode.js",
        ],
        "editor.tokenColorCustomizations": {
