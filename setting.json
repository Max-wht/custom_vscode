        "workbench.productIconTheme": "viraUIIcons",
        "workbench.iconTheme": "eyecons",
        "viraTheme.syncThemesAndIcons": false,
        "workbench.secondarySideBar.defaultVisibility": "hidden",
        "window.customTitleBarVisibility": "never",
        "editor.largeFileOptimizations": false,
        "[css]": {
                "editor.defaultFormatter": "esbenp.prettier-vscode",
        },
        "editor.occurrencesHighlight": "singleFile",
        "editor.selectionHighlight": true,
        "solidity-language-server.trace.server.verbosity": "message",
        "chatgpt.localeOverride": "en-US",
        "editor.wordWrap": "on",
        "window.confirmSaveUntitledWorkspace": false,

        "solidity.formatter": "forge",
        "solidity.monoRepoSupport": true,
        "solidity.packageDefaultDependenciesDirectory": ["node_modules", "lib"],
        "solidity.packageDefaultDependenciesContractsDirectory": [
                "src",
                "contracts",
                "",
        ],
        "solidity.remappingsUnix": [
                "@chainlink/contracts/=node_modules/@chainlink/contracts/",
                "@openzeppelin/contracts/=node_modules/@openzeppelin/contracts/",
                "@openzeppelin/contracts@4.8.3/=node_modules/.pnpm/@openzeppelin+contracts@4.8.3/node_modules/@openzeppelin/contracts/",
                "@openzeppelin/contracts@4.9.6/=node_modules/.pnpm/@openzeppelin+contracts@4.9.6/node_modules/@openzeppelin/contracts/",
                "@openzeppelin/contracts@5.0.2/=node_modules/.pnpm/@openzeppelin+contracts@5.0.2/node_modules/@openzeppelin/contracts/",
                "forge-std/=node_modules/forge-std/src/",
                "@cowprotocol/=src/vendor/@cowprotocol/contracts/src/contracts/",
        ],

        "claudeCode.preferredLocation": "panel",
        "explorer.confirmDragAndDrop": false,
        "workbench.editor.enablePreview": false,
        "workbench.startupEditor": "none",
        "git.openRepositoryInParentFolders": "never",
        "chat.mcp.gallery.enabled": true,
        "workbench.colorTheme": "Vira Sand",
        "editor.detectIndentation": false,
        "terminal.integrated.fontLigatures.enabled": true,
        "terminal.integrated.cursorStyle": "line",
        "workbench.sideBar.location": "right",
        "editor.minimap.showSlider": "always",
        "editor.minimap.size": "fill",
        "[typescript]": {
